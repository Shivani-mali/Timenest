# Environment configuration for Time Nest
FLASK_ENV=development
FLASK_DEBUG=1

# Common secret keys (replace with strong values in prod)
SECRET_KEY=dev-secret-key-change-me
JWT_SECRET_KEY=timenest-super-secret-jwt-key
JWT_EXPIRES_HOURS=24

# Firebase Configuration
FIREBASE_PROJECT_ID=timenest-16c50
# Path relative to backend/app.py
FIREBASE_SERVICE_ACCOUNT_KEY=backend/serviceAccountKey.json

# If you use Google OAuth 2.0 (standard flow)
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/api/auth/google/callback
