# TimeNest Environment Variables Example

# Flask Settings
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=generate-a-long-random-string-here
JWT_SECRET_KEY=generate-another-long-random-string-here

# Firebase Settings
# Option 1: Provide the JSON content of your service account key (Required for Vercel/Production)
# Remove all newlines and make it a single line string
FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "...", ...}

# Option 2: Path to the service account key file (Local Development Only)
FIREBASE_SERVICE_ACCOUNT_KEY=backend/serviceAccountKey.json
FIREBASE_PROJECT_ID=your-project-id

# JWT Settings
JWT_EXPIRES_HOURS=24
